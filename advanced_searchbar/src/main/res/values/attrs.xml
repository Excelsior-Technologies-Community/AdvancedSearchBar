<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AdvancedSearchBar">
        <!-- Icon Visibility -->
        <attr name="showSearchIcon" format="boolean" />
        <attr name="showVoiceIcon" format="boolean" />

        <!-- Search Bar Style -->
        <attr name="searchBarBackgroundColor" format="color" />
        <attr name="searchBarCornerRadius" format="dimension" />
        <attr name="searchBarElevation" format="dimension" />
        <attr name="searchBarPadding" format="dimension" />
        <attr name="searchBarMargin" format="dimension" />

        <!-- Text Style -->
        <attr name="hintText" format="string" />
        <attr name="textColor" format="color" />
        <attr name="hintColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="fontFamily" format="string|reference" />

        <!-- Icon Style -->
        <attr name="iconTint" format="color" />
        <attr name="iconSize" format="dimension" />
        <attr name="searchIconSize" format="dimension" />
        <attr name="voiceIconSize" format="dimension" />
        <attr name="clearIconSize" format="dimension" />

        <!-- EditText Padding -->
        <attr name="editTextPadding" format="dimension" />
        <attr name="editTextPaddingStart" format="dimension" />
        <attr name="editTextPaddingEnd" format="dimension" />

        <!-- Functionality -->
        <attr name="debounceTime" format="integer" />
    </declare-styleable>
</resources>